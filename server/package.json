{
  "name": "f1-prediction-backend",
  "version": "1.0.0",
  "description": "F1 Prediction Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "worker": "node --import tsx src/worker.ts",
    "worker:once": "node dist/worker.js --once",
    "preview:emails": "node --import tsx src/scripts/sendEmailPreviews.ts",
    "build": "tsc",
    "test": "npm run build && node --test dist/services/reminders.test.js dist/services/emailTemplates.test.js dist/middleware/auth.test.js dist/utils/appUrl.test.js dist/routes/reminderRunner.test.js",
    "start": "npm run build && node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^6.0.0",
    "nodemailer": "^8.0.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^7.0.11",
    "@types/ws": "^8.5.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
